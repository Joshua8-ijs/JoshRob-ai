# JoshRob Node.js gateway configuration
# Copy to .env and adjust for your deployment.

PORT=5000
PYTHON_SERVICE_URL=http://127.0.0.1:5001

# Generate with: node --input-type=module -e "import crypto from 'node:crypto'; console.log(crypto.randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Path to the built React app for production hosting
FRONTEND_DIST=../../frontend/dist

# Arduino / robot bridge endpoint (optional). Leave empty to use the built-in simulator.
ROBOT_BRIDGE_URL=
